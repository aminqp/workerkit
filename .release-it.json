{
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "header": "# Changelog"
    }
  },
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true,
    "requireUpstream": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": ["pnpm run lint", "pnpm run test"],
    "after:bump": "pnpm run build:lib"
  }
}
