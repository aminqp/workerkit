{
  "name": "@offmain/workerkit",
  "version": "0.14.0",
  "description": "A lightweight manager for running functions in Web Workers with partitioning, retries, and concurrency control",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/tools/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/tools/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./eslint-plugin": "./eslint-rules/index.cjs",
    "./eslint-rules/no-dom-in-worker": "./eslint-rules/no-dom-in-worker.cjs",
    "./eslint-rules/worker-exportable": "./eslint-rules/worker-exportable.cjs"
  },
  "files": [
    "dist",
    "eslint-rules"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "lint": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "release-it --ci",
    "release:patch": "release-it --increment patch --ci",
    "release:minor": "release-it --increment minor --ci",
    "release:major": "release-it --increment major --ci",
    "release:dry": "release-it --dry-run",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "keywords": [
    "web-worker",
    "worker",
    "concurrency",
    "parallel",
    "thread",
    "browser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aminqp/workerkit.git"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{js,cjs,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "release-it": "19.0.3",
    "typescript": "^5.7.2",
    "vite": "^6.3.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.0.0",
    "luxon": "^3.7.2",
    "i18next": "^25.5.1",
    "@types/luxon": "^3.7.2"
  }
}
